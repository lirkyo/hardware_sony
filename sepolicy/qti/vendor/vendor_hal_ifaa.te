binder_call(vendor_hal_ifaa_client, vendor_hal_ifaa_server)
binder_call(vendor_hal_ifaa_server, vendor_hal_ifaa_client)

add_hwservice(vendor_hal_ifaa_server, vendor_hal_ifaa_hwservice)
add_service(vendor_hal_ifaa_server, hal_ifaa_service)

allow vendor_hal_ifaa_client vendor_hal_ifaa_hwservice:hwservice_manager find;
allow vendor_hal_ifaa_client hal_ifaa_service:service_manager find;
