type vendor_hal_ifaa_default, domain;
hal_server_domain(vendor_hal_ifaa_default, vendor_hal_ifaa)

type vendor_hal_ifaa_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_hal_ifaa_default)

hal_client_domain(vendor_hal_ifaa_default, hal_allocator)

binder_call(vendor_hal_ifaa_default, servicemanager)

allow vendor_hal_ifaa_default hidl_memory_hwservice:hwservice_manager find;

allow vendor_hal_ifaa_default ion_device:chr_file r_file_perms;
allow vendor_hal_ifaa_default tee_device:chr_file rw_file_perms;
